<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="GitLab-CICD 整体流程总览">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="650">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 背景标题 -->
        <mxCell id="title" value="AutoTestHub GitLab-CICD 整体流程图" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="15" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- 1. 泳道一：MR 门禁流水线 -->
        <mxCell id="lane_mr" value="Merge Request 门禁流水线 (MR 触发) — 开发自测隔离环境" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;startSize=30;fontSize=12;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="940" height="150" as="geometry" />
        </mxCell>
        
        <!-- MR 流程节点 -->
        <mxCell id="job_mr_scan" value="&lt;b&gt;Stage: scan&lt;/b&gt;&lt;br&gt;Bandit 安全扫描&lt;br&gt;tsc 前端类型检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="lane_mr">
          <mxGeometry x="150" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_mr_unit" value="&lt;b&gt;Stage: unit-test&lt;/b&gt;&lt;br&gt;Pytest 单元测试&lt;br&gt;pytest-cov 覆盖率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="lane_mr">
          <mxGeometry x="310" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_mr_build" value="&lt;b&gt;Stage: build&lt;/b&gt;&lt;br&gt;后端字节码编译&lt;br&gt;前端 NPM 编译打包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="lane_mr">
          <mxGeometry x="470" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_mr_deploy" value="&lt;b&gt;Stage: deploy&lt;/b&gt;&lt;br&gt;部署开发自测环境&lt;br&gt;Docker 容器化验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="lane_mr">
          <mxGeometry x="630" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_mr_test" value="&lt;b&gt;Stage: test&lt;/b&gt;&lt;br&gt;网页与接口冒烟&lt;br&gt;本地 Runner 验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="lane_mr">
          <mxGeometry x="790" y="50" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- MR 触发条件标识 -->
        <mxCell id="cond_mr" value="&lt;b&gt;触发&lt;/b&gt;&lt;br&gt;feature/*&lt;br&gt;提交 MR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=none;fontSize=11;align=center;" vertex="1" parent="lane_mr">
          <mxGeometry x="10" y="45" width="100" height="70" as="geometry" />
        </mxCell>

        <!-- MR 连线 -->
        <mxCell id="el_mr_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D6B656;" edge="1" parent="lane_mr" source="cond_mr" target="job_mr_scan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_mr_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D6B656;" edge="1" parent="lane_mr" source="job_mr_scan" target="job_mr_unit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_mr_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D6B656;" edge="1" parent="lane_mr" source="job_mr_unit" target="job_mr_build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_mr_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D6B656;" edge="1" parent="lane_mr" source="job_mr_build" target="job_mr_deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_mr_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#D6B656;" edge="1" parent="lane_mr" source="job_mr_deploy" target="job_mr_test">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- 2. 泳道二：Master 持续部署流水线 -->
        <mxCell id="lane_master" value="Master 持续部署流水线 (合入触发) — 生产环境" style="swimlane;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;startSize=30;fontSize=12;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="940" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="cond_master" value="&lt;b&gt;触发&lt;/b&gt;&lt;br&gt;MR 合入&lt;br&gt;master" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=none;fontSize=11;align=center;" vertex="1" parent="lane_master">
          <mxGeometry x="10" y="45" width="100" height="70" as="geometry" />
        </mxCell>

        <mxCell id="job_m_build" value="&lt;b&gt;Stage: build&lt;/b&gt;&lt;br&gt;后端字节码编译&lt;br&gt;前端 NPM 编译打包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="lane_master">
          <mxGeometry x="470" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_m_deploy" value="&lt;b&gt;Stage: deploy&lt;/b&gt;&lt;br&gt;部署线上正式环境&lt;br&gt;生产服务器集群" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="lane_master">
          <mxGeometry x="630" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_m_test" value="&lt;b&gt;Stage: test&lt;/b&gt;&lt;br&gt;线上应用冒烟测试&lt;br&gt;&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="lane_master">
          <mxGeometry x="790" y="50" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Master 连线 -->
        <mxCell id="el_m_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6C8EBF;" edge="1" parent="lane_master" source="cond_master" target="job_m_build">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="80" />
              <mxPoint x="290" y="80" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="el_m_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6C8EBF;" edge="1" parent="lane_master" source="job_m_build" target="job_m_deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_m_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6C8EBF;" edge="1" parent="lane_master" source="job_m_deploy" target="job_m_test">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- 3. 泳道三：Release 版本发布流水线 -->
        <mxCell id="lane_release" value="Release 版本发布流水线 (分支推送触发) — 预发布环境" style="swimlane;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;startSize=30;fontSize=12;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="940" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="cond_release" value="&lt;b&gt;触发&lt;/b&gt;&lt;br&gt;推送分支&lt;br&gt;release/*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=none;fontSize=11;align=center;" vertex="1" parent="lane_release">
          <mxGeometry x="10" y="45" width="100" height="70" as="geometry" />
        </mxCell>

        <mxCell id="job_r_build" value="&lt;b&gt;Stage: build&lt;/b&gt;&lt;br&gt;后端字节码编译&lt;br&gt;前端 NPM 编译打包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;" vertex="1" parent="lane_release">
          <mxGeometry x="310" y="50" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="job_r_pkg" value="&lt;b&gt;Stage: package&lt;/b&gt;&lt;br&gt;打包版本正式制品&lt;br&gt;(.tar.gz 压缩归档)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;" vertex="1" parent="lane_release">
          <mxGeometry x="470" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_r_deploy" value="&lt;b&gt;Stage: deploy&lt;/b&gt;&lt;br&gt;部署版本验证环境&lt;br&gt;预发布测试服务器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;" vertex="1" parent="lane_release">
          <mxGeometry x="630" y="50" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="job_r_test" value="&lt;b&gt;Stage: test&lt;/b&gt;&lt;br&gt;预发布冒烟测试&lt;br&gt;AutoTestRunner 全量验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;" vertex="1" parent="lane_release">
          <mxGeometry x="790" y="50" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Release 连线 -->
        <mxCell id="el_r_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;" edge="1" parent="lane_release" source="cond_release" target="job_r_build">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="80" />
              <mxPoint x="200" y="80" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="el_r_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;" edge="1" parent="lane_release" source="job_r_build" target="job_r_pkg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_r_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;" edge="1" parent="lane_release" source="job_r_pkg" target="job_r_deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="el_r_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82B366;" edge="1" parent="lane_release" source="job_r_deploy" target="job_r_test">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- 4. 收尾与统一通知 (.post Stage - 统一的跨泳道流动) -->
        <mxCell id="lane_post" value=".post 收尾与通知阶段" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;startSize=30;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="200" height="510" as="geometry" />
        </mxCell>
        
        <mxCell id="job_post_report" value="&lt;b&gt;汇总报告&lt;/b&gt;&lt;br&gt;汇总流水线耗时&lt;br&gt;与单测覆盖率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=10;" vertex="1" parent="lane_post">
          <mxGeometry x="20" y="50" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="job_post_cloud" value="&lt;b&gt;结果上报&lt;/b&gt;&lt;br&gt;测试质量结果&lt;br&gt;自动上传云端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=10;" vertex="1" parent="lane_post">
          <mxGeometry x="20" y="230" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="job_post_notify" value="&lt;b&gt;即时通知&lt;/b&gt;&lt;br&gt;飞书机器人自动&lt;br&gt;推送结果至提交人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontSize=10;" vertex="1" parent="lane_post">
          <mxGeometry x="20" y="410" width="160" height="60" as="geometry" />
        </mxCell>
        
        <!-- 跨泳道连线指向 .post 卡片 -->
        <mxCell id="post_el1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#D6B656;" edge="1" parent="1" source="job_mr_test" target="job_post_report">
          <mxGeometry relative="1" as="geometry" />
