        <mxCell id="post_el3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#82B366;" edge="1" parent="1" source="job_r_test" target="job_post_notify">
