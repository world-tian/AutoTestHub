        <mxCell id="post_el2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6C8EBF;" edge="1" parent="1" source="job_m_test" target="job_post_cloud">
          <mxGeometry relative="1" as="geometry" />
